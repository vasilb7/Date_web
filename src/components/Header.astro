---
interface Props {
  activePage?: string;
}

const { activePage = '' } = Astro.props;
---

<!-- Header -->
<header class="header border-4 border-primary border-top position-fixed start-0 top-0 w-100">
  <div class="container">
    <div class="header-wrapper d-flex align-items-center justify-content-between">
      <div class="logo">
        <a href="/" class="logo-white text-decoration-none d-flex align-items-center">
          <span class="fs-9 fw-bolder text-white" style="letter-spacing: 1.5px;">JMB<span class="text-primary">.</span></span>
        </a>
        <a href="/" class="logo-dark text-decoration-none d-flex align-items-center">
          <span class="fs-9 fw-bolder text-dark" style="letter-spacing: 1.5px;">JMB<span class="text-primary">.</span></span>
        </a>
      </div>
      <div class="d-flex align-items-center gap-4">
        <div class="btn-group">
          <button
            class="btn btn-secondary toggle-menu round-45 p-2 d-flex align-items-center justify-content-center bg-white rounded-circle"
            type="button"
            data-bs-toggle="dropdown"
            data-bs-auto-close="true"
            aria-expanded="false"
            aria-label="Toggle navigation"
          >
            <iconify-icon icon="solar:hamburger-menu-line-duotone" class="menu-icon fs-8 text-dark"></iconify-icon>
          </button>
          <ul class="dropdown-menu dropdown-menu-end p-4">
            <div class="d-flex flex-column gap-6">
              <div class="hstack justify-content-between border-bottom pb-6">
                <p class="mb-0 fs-5 text-dark fw-bold">JMB Меню</p>
                <button type="button" class="btn-close opacity-75" aria-label="Close"></button>
              </div>
              <div class="d-flex flex-column gap-3">
                <ul class="header-menu list-unstyled mb-0 d-flex flex-column gap-2">
                  <li class="header-item">
                    <a
                      href="/"
                      class={`header-link ${activePage === 'home' ? 'active' : ''} hstack gap-2 fs-7 fw-bold text-dark`}
                      aria-current={activePage === 'home' ? 'page' : undefined}
                    >
                      <img
                        src="/assets/images/svgs/secondary-leaf.svg"
                        alt=""
                        width="20"
                        height="20"
                        class="img-fluid animate-spin"
                      />Покана
                    </a>
                  </li>
                  <li class="header-item">
                    <a
                      href="/#plans"
                      class="header-link hstack gap-2 fs-7 fw-bold text-dark"
                    >
                      <img
                        src="/assets/images/svgs/secondary-leaf.svg"
                        alt=""
                        width="20"
                        height="20"
                        class="img-fluid animate-spin"
                      />Идеи за среща
                    </a>
                  </li>
                  <li class="header-item">
                    <a
                      href="/about-us"
                      class={`header-link ${activePage === 'about' ? 'active' : ''} hstack gap-2 fs-7 fw-bold text-dark`}
                      aria-current={activePage === 'about' ? 'page' : undefined}
                    >
                      <img
                        src="/assets/images/svgs/secondary-leaf.svg"
                        alt=""
                        width="20"
                        height="20"
                        class="img-fluid animate-spin"
                      />За нас
                    </a>
                  </li>
                  <li class="header-item">
                    <a
                      href="/contact"
                      class={`header-link ${activePage === 'contact' ? 'active' : ''} hstack gap-2 fs-7 fw-bold text-dark`}
                      aria-current={activePage === 'contact' ? 'page' : undefined}
                    >
                      <img
                        src="/assets/images/svgs/secondary-leaf.svg"
                        alt=""
                        width="20"
                        height="20"
                        class="img-fluid animate-spin"
                      />Контакт
                    </a>
                  </li>
                </ul>
                <div class="hstack gap-2 mt-2">
                  <a
                    href="#plans"
                    class="btn btn-dark text-white fs-4 bg-dark px-3 py-2 w-100 hstack justify-content-center rounded-pill"
                  >Виж идеите за среща</a>
                </div>
              </div>
              <div class="border-top pt-3">
                <p class="mb-1 text-muted fs-3">Специален проект за среща</p>
                <span class="fs-5 text-dark fw-bold">JMB & Jerry</span>
              </div>
            </div>
          </ul>
        </div>
      </div>
    </div>
  </div>
</header>
