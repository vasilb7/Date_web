---
import Layout from "../layouts/Layout.astro";
import HeroJerryInput from "../components/HeroJerryInput.astro";
---

<Layout title="JMB - Специална покана за среща" activePage="home">
  <!--  Page Wrapper -->
  <div class="page-wrapper overflow-hidden">
    <!--  Banner Section -->
    <section
      class="banner-section position-relative d-flex align-items-center justify-content-center min-vh-100 overflow-hidden"
      style="background: #000000 url('/assets/images/backgrounds/banner.webp') center center / cover no-repeat;"
    >
      <video
        id="heroBannerVideo"
        class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        poster="/assets/images/backgrounds/banner.webp"
        style="z-index: 0; pointer-events: none;"
      >
        <source
          src="/assets/images/backgrounds/banner-video.mp4"
          type="video/mp4"
        />
      </video>

      <div
        class="container position-relative z-1 d-flex flex-column align-items-center justify-content-center text-center py-4"
      >
        <h2 class="hero-top-text text-white fw-bold">
          Само избраната може да разбере...
        </h2>
        <HeroJerryInput />
      </div>
    </section>

    <style>
      .hero-top-text {
        font-family: "Literata", Georgia, serif;
        font-size: clamp(1.25rem, 3.8vw, 1.85rem);
        font-weight: 600;
        font-style: italic;
        letter-spacing: -0.01em;
        text-shadow: 0 2px 14px rgba(0, 0, 0, 0.85);
        line-height: 1.4;
        max-width: 520px;
        margin-left: auto;
        margin-right: auto;
        margin-bottom: 28px;
      }
    </style>

    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        const video = document.getElementById("heroBannerVideo");
        if (video) {
          video.muted = true;
          const promise = video.play();
          if (promise !== undefined) {
            promise.catch(function () {
              // Browser requires user interaction; play on first click or touch
              const playOnTouch = function () {
                video.play();
                document.removeEventListener("click", playOnTouch);
                document.removeEventListener("touchstart", playOnTouch);
              };
              document.addEventListener("click", playOnTouch, { once: true });
              document.addEventListener("touchstart", playOnTouch, {
                once: true,
              });
            });
          }
        }
      });
    </script>
  </div>
</Layout>
