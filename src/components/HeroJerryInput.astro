---
// HeroJerryInput component with Jerry pointing image and bright name validation logic
---

<div class="hero-jerry-container">
  <!-- Jerry pointing down into the input field -->
  <div class="hero-jerry-avatar">
    <img
      src="/assets/images/backgrounds/jerry_pointing.webp"
      alt="Jerry pointing"
      loading="eager"
    />
  </div>

  <!-- Form state -->
  <form id="heroNameForm" class="hero-name-form" novalidate>
    <div id="heroNameCard" class="hero-name-card">
      <div class="hero-input-group">
        <input
          type="text"
          id="heroNameInput"
          name="name"
          class="hero-name-input"
          placeholder="Твоето Име"
          autocomplete="off"
          required
        />
        <button
          type="submit"
          id="heroSubmitBtn"
          class="search-arrow-btn"
          aria-label="Продължи"
        >
          <iconify-icon icon="lucide:arrow-right" class="fs-5"></iconify-icon>
        </button>
      </div>
    </div>

    <!-- Bright High-Contrast Error Message Badge -->
    <div class="text-center w-100">
      <div id="heroNameError" class="hero-name-error" aria-live="polite"></div>
    </div>
  </form>

  <!-- Success state greeting (clean and centered) -->
  <div id="heroSuccessCard" class="hero-name-success">
    <div
      class="d-flex flex-column gap-4 text-center align-items-center justify-content-center py-2"
    >
      <h3 class="mb-0 text-dark fw-bold fs-7" id="heroGreetingTitle">
        Здравей, Дария!
      </h3>

      <div class="w-100 d-flex justify-content-center">
        <a href="/invite" id="heroSeeInviteBtn" class="hero-see-invite-btn">
          Виж поканата
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .hero-jerry-container {
    position: relative;
    width: 100%;
    max-width: 440px;
    margin: 120px auto 0;
    z-index: 10;
  }

  .hero-jerry-avatar {
    position: absolute;
    top: -135px;
    left: 50%;
    transform: translateX(-50%);
    width: 195px;
    height: 195px;
    pointer-events: none;
    user-select: none;
    z-index: 20;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-jerry-avatar img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 10px 22px rgba(0, 0, 0, 0.5));
    border: none;
  }

  .hero-name-form {
    width: 100%;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-name-card {
    position: relative;
    width: 100%;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: 16px;
    padding: 6px;
    box-shadow: 0 16px 36px -4px rgba(0, 0, 0, 0.45);
    border: 2px solid rgba(255, 255, 255, 0.9);
    transition: all 0.2s ease;
  }

  .hero-name-card:focus-within {
    border-color: #141414;
    background: #ffffff;
    box-shadow: 0 20px 42px -4px rgba(0, 0, 0, 0.55);
  }

  /* Bright red glow on error */
  .hero-name-card.has-error {
    border-color: #ff1744 !important;
    background: #ffffff !important;
    box-shadow:
      0 0 0 4px rgba(255, 23, 68, 0.35),
      0 16px 36px rgba(0, 0, 0, 0.4) !important;
  }

  .hero-input-group {
    display: flex;
    align-items: center;
    position: relative;
    width: 100%;
    height: 52px;
  }

  .hero-name-input {
    flex: 1 1 auto;
    height: 100%;
    background: transparent !important;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    font-size: 18px;
    font-family: inherit;
    font-weight: 600;
    color: #141414;
    padding: 0 18px;
  }

  .hero-name-input::placeholder {
    color: #71717a;
    font-weight: 500;
  }

  .search-arrow-btn {
    height: 42px;
    width: 46px;
    border-radius: 12px;
    background: #141414;
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: none;
    cursor: pointer;
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 2px 6px -1px rgba(0, 0, 0, 0.25);
    flex-shrink: 0;
    margin-right: 3px;
  }

  .search-arrow-btn:hover {
    background: #000000;
    transform: translateY(-1px);
    box-shadow: 0 4px 10px -2px rgba(0, 0, 0, 0.35);
  }

  .search-arrow-btn:active {
    transform: scale(0.92) translateY(1px);
    background: #262626;
  }

  /* Ultra-vivid, high-contrast bright red error badge */
  .hero-name-error {
    display: none;
    color: #ffffff !important;
    background: linear-gradient(135deg, #ff1744 0%, #d50000 100%);
    font-size: 14px;
    font-weight: 700;
    padding: 8px 18px;
    border-radius: 50px;
    margin-top: 14px;
    text-align: center;
    box-shadow: 0 8px 24px rgba(255, 23, 68, 0.6);
    border: 1.5px solid rgba(255, 255, 255, 0.5);
    letter-spacing: 0.2px;
    animation: mat-subscript-enter 0.25s cubic-bezier(0, 0, 0.2, 1);
  }

  .hero-name-success {
    display: none;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: 20px;
    padding: 24px 28px;
    box-shadow: 0 20px 42px -4px rgba(0, 0, 0, 0.45);
    border: 2px solid #22c55e;
    animation: mat-subscript-enter 0.3s ease-out;
  }

  .hero-see-invite-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #141414 !important;
    color: #ffffff !important;
    font-size: 18px !important;
    font-weight: 700 !important;
    padding: 12px 36px !important;
    border-radius: 50px !important;
    text-decoration: none !important;
    border: 2px solid #141414 !important;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.3) !important;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
    cursor: pointer;
    line-height: 1.4;
  }

  .hero-see-invite-btn:hover {
    background-color: #000000 !important;
    color: #ffffff !important;
    transform: translateY(-2px);
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.4) !important;
  }

  .hero-see-invite-btn:active {
    transform: scale(0.96);
  }

  @keyframes shake {
    0%,
    100% {
      transform: translateX(0);
    }
    20%,
    60% {
      transform: translateX(-8px);
    }
    40%,
    80% {
      transform: translateX(8px);
    }
  }

  .animate-shake {
    animation: shake 0.4s ease-in-out;
  }

  @keyframes mat-subscript-enter {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>

<script is:inline>
  function setupHeroNameLogic() {
    const form = document.getElementById("heroNameForm");
    const input = document.getElementById("heroNameInput");
    const card = document.getElementById("heroNameCard");
    const errorEl = document.getElementById("heroNameError");
    const successCard = document.getElementById("heroSuccessCard");
    const greetingTitle = document.getElementById("heroGreetingTitle");
    const resetBtn = document.getElementById("heroResetBtn");

    if (!form || !input || !card || !errorEl || !successCard) return;

    const NAME_ERROR_MESSAGE = "Опа,май обърка нещо? - пробвай пак.";
    const EMPTY_ERROR_MESSAGE = "Полето е задължително";

    function isAllowedName(val) {
      if (!val) return false;
      const clean = val
        .trim()
        .toLowerCase()
        .replace(/^[^\p{L}]+|[^\p{L}]+$/gu, "");
      const validSet = new Set([
        "дария",
        "даря",
        "дари",
        "дарийка",
        "дариика",
        "дариа",
        "дарийче",
        "дарина",
        "даринка",
        "даринче",
        "даринчи",
        "daria",
        "dariya",
        "darya",
        "daryia",
        "dariq",
        "dari",
        "dariika",
        "dariah",
        "darriah",
        "darina",
        "darinka",
        "darinche",
        "darinchi",
        "daryna",
        "darin",
      ]);
      if (validSet.has(clean)) return true;
      if (/^дар(и|ия|я|ийка|иика|иа|ийче|ина|инка|инче|инчи)$/i.test(clean)) return true;
      if (/^dar(i|ia|iya|ya|yia|iq|ika|iika|iah|ina|inka|inche|inchi|yna|in)$/i.test(clean)) return true;
      return false;
    }

    function triggerShake() {
      form.classList.remove("animate-shake");
      void form.offsetWidth;
      form.classList.add("animate-shake");
    }

    function showError(msg) {
      card.classList.add("has-error");
      errorEl.innerHTML =
        '<iconify-icon icon="solar:danger-triangle-bold" class="fs-5 me-1" style="vertical-align: -2px;"></iconify-icon> ' +
        msg;
      errorEl.style.display = "inline-flex";
      errorEl.style.alignItems = "center";
      triggerShake();
    }

    function clearError() {
      card.classList.remove("has-error");
      errorEl.textContent = "";
      errorEl.style.display = "none";
    }

    function showSuccess(nameVal) {
      clearError();
      const formatted =
        nameVal.trim().charAt(0).toUpperCase() + nameVal.trim().slice(1);
      greetingTitle.textContent = "Здравей, " + formatted + "!";
      const inviteBtn = document.getElementById("heroSeeInviteBtn");
      if (inviteBtn) {
        inviteBtn.href = "/invite?to=" + encodeURIComponent(formatted);
      }
      form.style.display = "none";
      successCard.style.display = "block";
    }

    // Check URL parameters for preset name (?to=... or ?name=...)
    try {
      const params = new URLSearchParams(window.location.search);
      const urlName = (params.get("to") || params.get("name") || "").trim();
      if (urlName) {
        input.value = urlName;
        if (isAllowedName(urlName)) {
          showSuccess(urlName);
        }
      }
    } catch (e) {
      // Ignore URL parsing errors
    }

    input.addEventListener("input", function () {
      clearError();
    });

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      const trimmed = input.value.trim();

      if (!trimmed) {
        showError(EMPTY_ERROR_MESSAGE);
        input.focus();
        return;
      }

      if (!isAllowedName(trimmed)) {
        let failedCount = parseInt(
          sessionStorage.getItem("jmb_failed_attempts") || "0",
          10
        );
        failedCount += 1;
        sessionStorage.setItem("jmb_failed_attempts", failedCount.toString());

        // Send failed attempt log to backend & Telegram
        try {
          fetch("/api/log-failed-name", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              name: trimmed,
              attempt_count: failedCount,
              session_id: sessionStorage.getItem("jmb_visitor_session") || "",
            }),
          }).catch(function (err) {
            console.warn("Failed to report failed name attempt:", err);
          });
        } catch (e) {
          // Ignore network errors
        }

        showError(NAME_ERROR_MESSAGE);
        input.focus();
        return;
      }

      showSuccess(trimmed);
    });

    if (resetBtn) {
      resetBtn.addEventListener("click", function () {
        successCard.style.display = "none";
        form.style.display = "flex";
        input.value = "";
        clearError();
        input.focus();
      });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupHeroNameLogic);
  } else {
    setupHeroNameLogic();
  }
</script>
