---
import Header from '../components/Header.astro';
import VisitorTracker from '../components/VisitorTracker.astro';

interface Props {
  title?: string;
  description?: string;
  activePage?: string;
  showHeader?: boolean;
}

const {
  title = 'JMB - Покани за среща',
  description = 'JMB е специално преживяване и покана за незабравима среща.',
  activePage = '',
  showHeader = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/webp" href="/assets/images/logos/icon.webp" />
    <link rel="shortcut icon" type="image/webp" href="/assets/images/logos/icon.webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400..700;1,7..72,400..700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/assets/libs/owl.carousel/dist/assets/owl.carousel.min.css" />
    <link rel="stylesheet" href="/assets/css/styles.css" />
  </head>
  <body>
    {showHeader && <Header activePage={activePage} />}

    <slot />

    <script is:inline src="/assets/libs/jquery/dist/jquery.min.js"></script>
    <script is:inline src="/assets/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script is:inline src="/assets/libs/owl.carousel/dist/owl.carousel.min.js"></script>
    <script is:inline src="/assets/js/custom.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/iconify-icon@1.0.8/dist/iconify-icon.min.js"></script>

    <VisitorTracker />
  </body>
</html>
